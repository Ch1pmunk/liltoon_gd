; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="新建游戏项目"
run/main_scene="res://addons/liltoon_gd/demo/showcase.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
run/max_fps=30

[autoload]

LiltoonAudioLink="*res://addons/liltoon_gd/audio/liltoon_audio_link.gd"
MCPRuntimeProbe="*uid://bsg12huaf1u5i"

[display]

window/size/viewport_width=540
window/size/viewport_height=360
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/vsync/vsync_mode=0

[dotnet]

project/assembly_name="新建游戏项目"

[editor_plugins]

enabled=PackedStringArray("res://addons/godot_mcp/plugin.cfg", "res://addons/liltoon_gd/plugin.cfg")

[liltoon_gd]

language="zh"
installed_version="1.0.1"
default_preset="默认"
quality_tier="high"
bake_size=512
startup_check_done=false

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

rendering_device/driver.windows="d3d12"

[shader_globals]

audiolink_bands={
"type": "vec4",
"value": "Vector4(0, 0, 0, 0)"
}
audiolink_texture={
"type": "sampler2D",
"value": ""
}
audiolink_time={
"type": "float",
"value": 0.0
}
