static func get_names() -> Array[String]:
	return ORDER.duplicate()


static func get_preset(preset_name: String) -> Dictionary:
	var data := BASE.duplicate()
	var overrides: Dictionary = OVERRIDES.get(preset_name, {})
	for key in overrides:
		data[key] = overrides[key]
	return data


static func apply_to_material(mat: ShaderMaterial, preset_name: String) -> void:
	if mat == null:
		return
	var data := get_preset(preset_name)
	var outline_data := {}
	for key in data:
		if key in OUTLINE_KEYS:
			outline_data[key] = data[key]
		elif key == "use_alpha_to_mask":
			# 该键控制 shader 变体（alpha_to_coverage），不是 shader uniform。
			LiltoonMaterialFactory.set_alpha_to_mask(mat, bool(data[key]))
		elif key != "outline_enabled":
			mat.set_shader_parameter(key, data[key])

	if bool(data.get("outline_enabled", true)):
		LiltoonMaterialFactory.set_outline_enabled(mat, true)
		var outline := LiltoonMaterialFactory.get_outline_material(mat)
		if outline != null:
			for key in outline_data:
				outline.set_shader_parameter(key, outline_data[key])
			# 预设只写参数不会换 shader 变体，这里按参数重现选择受光/透明/预乘组合。
			LiltoonMaterialFactory.set_outline_lighting(mat, bool(outline_data.get("outline_enable_lighting", false)))
			LiltoonMaterialFactory.set_outline_transparency(mat, bool(outline_data.get("outline_apply_transparency", false)))
			outline.emit_changed()
	else:
		LiltoonMaterialFactory.set_outline_enabled(mat, false)
	mat.emit_changed()
